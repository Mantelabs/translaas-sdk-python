# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.py text eol=lf
*.pyi text eol=lf
*.pyw text eol=lf
*.pyx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.rst text eol=lf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Compiled Python files
*.pyc binary
*.pyo binary
*.pyd binary
*.so binary
*.egg binary
*.whl binary
